# Copy this file to .env and fill in your values. .env is git-ignored.

# Supabase / PostgreSQL connection string (URI form).
# Project Settings -> Database -> Connection string -> URI -> Transaction pooler.
# When this is set, the app uses Postgres; when unset, it falls back to local SQLite.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
